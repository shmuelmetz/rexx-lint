/* Fixture: nothing here compares a known boolean with a constant. */

flag = .false
done = .true
if flag then say 'a'
if count = 0 then say 'b'
if datatype(n) = 'NUM' then say 'c'
if lines(f) > 0 then say 'd'
if n + abbrev(a, b) = 1 then say 'e'
if abbrev(a, b) + 1 = 2 then say 'f'
if s~hasIndex(k) then say 'g'
if pos('x', s) = 0 then say 'h'
if s~datatype = 'CHAR' then say 'i'
y = (a = b)
use strict arg parser, include = .True
/* Numeric values compared with 0 or 1 are not booleans to this check. */
if n = 0 then say 'j'
if count == 1 then say 'k'
if rc <> 0 then say 'l'
if stem.0 = 0 then say 'm'
if q~items = 0 then say 'n'
if length(s) = 1 then say 'o'
if pos('x', s) \= 0 then say 'p'
if (a + b) = 1 then say 'q'
if (-n) = 0 then say 'r'
if 1 = n then say 's'
if 0 == length(s) then say 't'
if s~pos('x') = 1 then say 'u'
if verify(s, '01') = 0 then say 'v'
if ¬flag then say 'w'
if ªflag then say 'x'

/* Every comparison spelling, with numeric operands: no findings. */
if n = 0 then say 'op'
if n == 0 then say 'op'
if n <> 0 then say 'op'
if n >< 0 then say 'op'
if n > 0 then say 'op'
if n < 0 then say 'op'
if n >= 0 then say 'op'
if n <= 0 then say 'op'
if n >> 0 then say 'op'
if n << 0 then say 'op'
if n >>= 0 then say 'op'
if n <<= 0 then say 'op'
if n \= 0 then say 'op'
if n ª= 0 then say 'op'
if n ¬= 0 then say 'op'
if n \== 0 then say 'op'
if n ª== 0 then say 'op'
if n ¬== 0 then say 'op'
if n \> 0 then say 'op'
if n ª> 0 then say 'op'
if n ¬> 0 then say 'op'
if n \< 0 then say 'op'
if n ª< 0 then say 'op'
if n ¬< 0 then say 'op'
if n \>> 0 then say 'op'
if n ª>> 0 then say 'op'
if n ¬>> 0 then say 'op'
if n \<< 0 then say 'op'
if n ª<< 0 then say 'op'
if n ¬<< 0 then say 'op'
/* NOT applied to a boolean, with each NOT character. */
if \flag then say 'not'
if \abbrev(a, b) then say 'not'
if ªflag then say 'not'
if ªabbrev(a, b) then say 'not'
if ¬flag then say 'not'
if ¬abbrev(a, b) then say 'not'
